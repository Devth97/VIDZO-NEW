# Names only. Never commit real values. Configure secrets in the hosting provider's encrypted settings.

# demo | local | live   (default: demo)
#   demo  = browser-only explore mode
#   local = full stack on this machine (PGlite, disk storage, simulated providers); run `pnpm dev:local`
#   live  = real services; each capability returns 503 until its variables are set
VIDZO_MODE=

# Comma-separated emails that receive the admin role on sign-in
VIDZO_ADMIN_EMAILS=
# Public origin used in sign-in email links, e.g. https://vidzo.tech
APP_ORIGIN=

# Pricing JSON (see src/lib/domain/pricing.ts). Live mode refuses to quote until set with "illustrative": false
VIDZO_PRICING_JSON=

# Supabase Auth + Postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=

# Cloudflare R2 (private bucket, CORS limited to APP_ORIGIN)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Gemini video analysis
GEMINI_API_KEY=
GEMINI_MODEL=

# fal queue endpoints chosen by the benchmark
FAL_KEY=
FAL_IMAGE_ENDPOINT=
FAL_VIDEO_ENDPOINT_PROFESSIONAL=
FAL_VIDEO_ENDPOINT_PREMIUM=
# Optional: comma-separated allowed result hosts
FAL_RESULT_HOSTS=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Media worker (FFmpeg assembly)
MEDIA_WORKER_URL=
MEDIA_WORKER_TOKEN=
