{
  "name": "vidzo-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "worker:test": "python -m unittest discover -s services/media-worker/tests",
    "dev:local": "node scripts/dev-local.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1176.0",
    "@aws-sdk/s3-request-presigner": "3.1176.0",
    "@electric-sql/pglite": "0.6.0",
    "@google/genai": "3.6.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "@trigger.dev/sdk": "4.8.10",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
